      <column caption='Web Visit Group' datatype='string' name='[Calculation_1911521639010308]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [NumWebVisitsMonth] = 0 THEN &apos;0 Visits&apos;&#13;&#10;ELSEIF [NumWebVisitsMonth] &lt;= 2 THEN &apos;1-2 Visits&apos;&#13;&#10;ELSEIF [NumWebVisitsMonth] &lt;= 4 THEN &apos;3-4 Visits&apos;&#13;&#10;ELSEIF [NumWebVisitsMonth] &lt;= 6 THEN &apos;5-6 Visits&apos;&#13;&#10;ELSEIF [NumWebVisitsMonth] &lt;= 8 THEN &apos;7-8 Visits&apos;&#13;&#10;ELSE &apos;9+ Visits&apos;&#13;&#10;END' />
