      <column caption='Age Group' datatype='string' name='[Calculation_2191071721709571]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 30 THEN &apos;Under 30&apos;&#13;&#10;ELSEIF [Age] &lt;40 THEN &apos;30-39&apos;&#13;&#10;ELSEIF [Age]&lt;50 THEN &apos;40-49&apos;&#13;&#10;ELSEIF [Age]&lt;60 THEN &apos;50-59&apos;&#13;&#10;ELSE &apos;60+&apos;&#13;&#10;END' />
