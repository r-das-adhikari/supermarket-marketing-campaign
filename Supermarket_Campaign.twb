      <column caption='Avg Customer Value' datatype='real' name='[Calculation_0373852743999489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1525316289662976]/[Calculation_0373852742451200]' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_0373852797210626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Spending])/SUM([Total_Purchases])' />
      </column>
      <column caption='Web Revenue' datatype='real' name='[Calculation_0373852821172227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Spending])* SUM([NumWebPurchases])/SUM([Total_Purchases])' />
      </column>
      <column caption='Catalog Revenue' datatype='real' name='[Calculation_0373852821499908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Spending])*SUM([NumCatalogPurchases])/SUM([Total_Purchases])' />
      </column>
      <column caption='Store Revenue' datatype='real' name='[Calculation_0373852821929989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Spending])*SUM([NumStorePurchases])/SUM([Total_Purchases])' />
      </column>
      <column caption='Deals Revenue' datatype='real' name='[Calculation_0373852822200326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Spending])*SUM([NumDealsPurchases])/SUM([Total_Purchases])' />
      </column>
      <column caption='Sparkline Dot' datatype='integer' name='[Calculation_0602550801879042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Dt_Customer]={MAX([Dt_Customer])} THEN [Total_Spending] END' />
      </column>
      <column caption='Responded ' datatype='real' name='[Calculation_0608323922243584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Response]= True THEN 1 ELSE 0 END)/5' />
      </column>
      <column caption='Not Responded ' datatype='real' name='[Calculation_0608323922743297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNT([Id])/5 )-[Calculation_0608323922243584]' />
      </column>
      <column caption='Response Rate' datatype='real' name='[Calculation_0608323922964482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0608323922243584]/([Calculation_0608323922243584]+ [Calculation_0608323922743297])' />
      </column>
      <column caption='Total Purchases KPI' datatype='real' name='[Calculation_0804862721384448]' role='measure' type='quantitative'>
