    <worksheet name='Web Visits vs Purchases'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#e8e8e8' fontname='Benton Sans Book' fontsize='11'>Does Web Engagement Drive Higher Purchases?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Supermarket_Campaign_DB' name='federated.1vi3xsm1xu7bal18wals21w07avw' />
          </datasources>
          <datasource-dependencies datasource='federated.1vi3xsm1xu7bal18wals21w07avw'>
            <column caption='Web Visit Group' datatype='string' name='[Calculation_1911521639010308]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [NumWebVisitsMonth] = 0 THEN &apos;0 Visits&apos;&#13;&#10;ELSEIF [NumWebVisitsMonth] &lt;= 2 THEN &apos;1-2 Visits&apos;&#13;&#10;ELSEIF [NumWebVisitsMonth] &lt;= 4 THEN &apos;3-4 Visits&apos;&#13;&#10;ELSEIF [NumWebVisitsMonth] &lt;= 6 THEN &apos;5-6 Visits&apos;&#13;&#10;ELSEIF [NumWebVisitsMonth] &lt;= 8 THEN &apos;7-8 Visits&apos;&#13;&#10;ELSE &apos;9+ Visits&apos;&#13;&#10;END' />
            </column>
            <column caption='Avg Web Purchases' datatype='real' name='[Calculation_1911521640087557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([NumWebPurchases])/COUNTD([Id])' />
            </column>
            <column datatype='string' name='[Education]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Postgraduate&quot;' value='PG' />
                <alias key='&quot;Undergraduate&quot;' value='UG' />
